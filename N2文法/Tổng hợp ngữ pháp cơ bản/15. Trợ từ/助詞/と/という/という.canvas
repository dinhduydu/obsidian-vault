		{"id":"f3e81394393cac1d","type":"text","text":"**A というより B**\nđúng hơn là / nói đúng hơn là / không phải A mà là B\n→ sửa lại cách nói cho chính xác hơn","x":-2481,"y":490,"width":480,"height":100},
		{"id":"181394d70055e348","type":"text","text":"Ko phải A mà đúng hơn là B","x":-3444,"y":430,"width":250,"height":60},
		{"id":"cbe5649b0dc85aef","type":"text","text":"というより","x":-3027,"y":316,"width":250,"height":60},
		{"id":"a482079dc8467c73","type":"file","file":"N2文法/Tổng hợp ngữ pháp cơ bản/15. Trợ từ/助詞/と/という/というわけ.canvas","x":-1841,"y":2040,"width":400,"height":400},
		{"id":"8b95c68cf206d535","type":"file","file":"Chữa đề/Learning_Profile/Grammar/というより.md","x":-2589,"y":-84,"width":400,"height":400},
		{"id":"18adb54dead3503a","type":"text","text":"Dùng khi muốn nói cách nói A cũng đúng nhưng B thì thích hợp hơn","x":-3411,"y":152,"width":250,"height":82},
		{"id":"1397b9137fdd16da","type":"text","text":"夢を諦めるのは、残念というより悔しい。","x":-3729,"y":46,"width":250,"height":60},
