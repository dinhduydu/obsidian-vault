		{"id":"e9e0945e625cbd26","type":"text","text":"Dùng khi nhờ vả","x":223,"y":-684,"width":250,"height":60},
		{"id":"2078de216703cf0d","type":"text","text":"Vてくれといわれる","x":-718,"y":1120,"width":250,"height":60},
		{"id":"5053b6bb77349a0f","type":"text","text":"～（さ）せてもらえませんか","x":-421,"y":-889,"width":293,"height":51},
		{"id":"324f28d00c6228c6","type":"text","text":"Dùng khi xin phép 1 cách lịch sự đối với hành vi của bản thân","x":19,"y":-1050,"width":329,"height":81},
		{"id":"faaeb6dc3e0870f2","type":"text","text":"làm A được không ạ","x":527,"y":-1124,"width":250,"height":60},
		{"id":"8ff5dc0ca1e2164d","type":"text","text":"Dùng khi cho đối phương biết 1 cách gián tiếp nội dung mình được nhờ vả","x":-354,"y":1120,"width":362,"height":60},
		{"id":"606da1bdc5ab4a42","type":"text","text":"母に今日ははやく帰ってきてくれと言われる。","x":419,"y":951,"width":250,"height":60},
		{"id":"d9673ba173580def","type":"text","text":"友達にケーキをつくってくれとたのまれた。","x":460,"y":1251,"width":250,"height":60},
		{"id":"24b1296bedd6b3f1","type":"text","text":"例： 部長に仕事を教えていただきました。","x":87,"y":41,"width":373,"height":60},
		{"id":"f510749b470acaa2","type":"text","text":"Thể hiện sự kính trọng với bề trên","x":-479,"y":384,"width":250,"height":60},
