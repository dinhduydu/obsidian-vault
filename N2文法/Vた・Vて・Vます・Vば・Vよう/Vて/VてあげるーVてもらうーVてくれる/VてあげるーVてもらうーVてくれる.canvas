{
	"nodes":[
		{"id":"fde3890b1a93e091","type":"text","text":"Diễn tả những cái gì đó theo hướng lại gần với vị trí của người nói","x":-1342,"y":1231,"width":250,"height":119},
		{"id":"f2253b4b927fec14","type":"text","text":"Vてもらう","x":-1450,"y":344,"width":250,"height":79},
		{"id":"480f73156ec7ed64","type":"text","text":"（Nを）あげる～てあげる\n（Nを）もらう～てもらう\n（Nを）くれる～てくれる","x":-2109,"y":792,"width":250,"height":102},
		{"id":"0ad89edbe1085fe2","type":"text","text":"Truyền đạt nguyện vọng muốn người khác làm gì đó cho mình","x":339,"y":691,"width":241,"height":88},
		{"id":"eeafa3b6d86490ca","type":"text","text":"子供には、できたら私の会社を手伝ってもらいたいと思っています。","x":776,"y":557,"width":543,"height":54},
		{"id":"f025b3f399aaaa71","type":"text","text":"お時間のある方に、この仕事を手伝ってもらいたいんですが。","x":792,"y":711,"width":527,"height":60},
		{"id":"88a86ee990c6d497","type":"text","text":"てもらいたいんですが。","x":1488,"y":650,"width":250,"height":60},
		{"id":"9447dee19c7f0cfc","type":"text","text":"頼みたいときに使う。","x":1860,"y":586,"width":250,"height":60},
		{"id":"48b28f0bbf8400c1","type":"text","text":"（上に）Vていただく","x":-908,"y":11,"width":250,"height":60},
