		{"id":"e4278c860c2a38b2","type":"text","text":"GENERATIVE WRITING hoặc freewriting.","x":1380,"y":-339,"width":250,"height":60},
		{"id":"116b26fc802bee30","type":"text","text":"viết liên tục trong một khoảng thời gian nhất định mà chưa dừng lại để chỉnh sửa, đánh giá hoặc tìm cách diễn đạt hoàn hảo","x":1820,"y":-660,"width":455,"height":100},
