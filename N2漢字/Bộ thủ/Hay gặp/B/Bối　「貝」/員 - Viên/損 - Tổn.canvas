		{"id":"b764934b2a7d1096","x":1000,"y":101,"width":346,"height":143,"type":"text","text":"\n大損 ( おおぞん) - sự lỗ lớn; khoản lỗ lớn; lỗ lớn; thua lỗ lớn; thiệt hại lớn; thiệt hại nặng nề; tổn thất lớn; tổn thất nặng nề; thua nhiều tiền; mất nhiều tiền"},
		{"id":"f7d54ce89f0e9d63","x":940,"y":340,"width":250,"height":60,"type":"text","text":"損害 ( そんがい) - phương hại"},
		{"id":"4152780bb316086f","x":1000,"y":-162,"width":250,"height":60,"type":"text","text":"損得 ( そんとく) - sự lỗ lãi; việc được mất; cái mất và cái được ."},
		{"id":"de8aba64ac6f5813","x":220,"y":560,"width":250,"height":60,"type":"text","text":"損じ (そんじ) - sự trượt chân"}
