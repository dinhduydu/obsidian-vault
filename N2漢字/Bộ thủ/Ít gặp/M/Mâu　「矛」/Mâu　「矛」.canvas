		{"id":"4d17e8e25f8593ed","type":"text","text":"騖　「むやみに」：lao tới, chạy theo","x":254,"y":340,"width":250,"height":60},
		{"id":"cfcb61e02062049d","type":"text","text":"務 = 矛 + 攵\n\nBan đầu mang ý \"cầm giáo làm việc\", sau thành nghĩa \"nhiệm vụ, công vụ\".","x":700,"y":31,"width":364,"height":119},
		{"id":"3396890c2c830ac2","type":"text","text":"霧　「きり」：sương mù","x":700,"y":235,"width":250,"height":50},
		{"id":"e1aae3f5966ab7ce","type":"text","text":"霧 = 雨 + 務\n\nChữ hình thanh, trong đó 務 chủ yếu gợi âm.","x":1100,"y":231,"width":398,"height":109},
		{"id":"98c978bf9bf4d527","type":"text","text":"矛 = hình cây giáo cổ đại, là một bộ thủ độc lập chứ không phải ghép từ những chữ Hán đơn giản khác.","x":-560,"y":-343,"width":280,"height":143},
